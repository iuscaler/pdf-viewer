<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PDFViewer.Core\PDFViewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 창 제목 표시줄·작업 표시줄 아이콘 -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 실행 파일 이름: PDFViewer.exe -->
    <AssemblyName>PDFViewer</AssemblyName>
    <Product>PDF Viewer</Product>
    <Version>1.0.3</Version>
    <!-- 실행 파일 아이콘 (원본: Assets/app.svg) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 셰이더 컴파일러(d3dcompiler_47.dll) 호출에 포인터를 쓴다 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
