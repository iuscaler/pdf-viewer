<Application x:Class="PDFViewer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PDFViewer.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="ToolbarBackground" Color="#F9F9F9" />
        <SolidColorBrush x:Key="ToolbarBorder" Color="#E5E5E5" />
        <SolidColorBrush x:Key="DocumentBackground" Color="#E8E8E8" />
        <SolidColorBrush x:Key="ButtonHover" Color="#14000000" />
        <SolidColorBrush x:Key="ButtonPressed" Color="#24000000" />
        <SolidColorBrush x:Key="ButtonChecked" Color="#1F0067C0" />

        <!-- 툴바의 납작한 버튼 -->
        <Style x:Key="ToolButtonStyle" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonPressed}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonChecked}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!-- 아이콘 글꼴에 알맞은 모양이 없는 보기 버튼용 선 아이콘 (16x16 좌표). 도구 모음과 보기 메뉴에 함께 쓴다.
             비활성 버튼은 버튼 템플릿이 통째로 흐리게 하므로 선 색은 고정이다. -->
        <Style x:Key="IconPathStyle" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Stroke" Value="#1A1A1A" />
        </Style>
        <!-- 너비 맞춤: 양쪽 끝까지 늘어나는 화살표 -->
        <Geometry x:Key="FitWidthIcon">M1.5,3 V13 M14.5,3 V13 M3.5,8 H12.5 M5.5,6 L3.5,8 L5.5,10 M10.5,6 L12.5,8 L10.5,10</Geometry>
        <!-- 페이지 맞춤: 네 모서리 안에 들어간 페이지 -->
        <Geometry x:Key="FitPageIcon">M5.5,4.5 H10.5 V11.5 H5.5 Z M1.5,4.5 V1.5 H4.5 M11.5,1.5 H14.5 V4.5 M14.5,11.5 V14.5 H11.5 M4.5,14.5 H1.5 V11.5</Geometry>
        <!-- 1페이지 보기 -->
        <Geometry x:Key="SinglePageIcon">M4.5,1.5 H11.5 V14.5 H4.5 Z M6.5,5 H9.5 M6.5,7.5 H9.5 M6.5,10 H9.5</Geometry>
        <!-- 2페이지 보기 -->
        <Geometry x:Key="TwoPageIcon">M1.5,2.5 H7.5 V13.5 H1.5 Z M8.5,2.5 H14.5 V13.5 H8.5 Z</Geometry>
        <!-- 연속 스크롤: 위아래로 이어지는 페이지 -->
        <Geometry x:Key="ContinuousIcon">M4.5,0.5 V5.5 H11.5 V0.5 M4.5,15.5 V8.5 H11.5 V15.5</Geometry>
        <!-- 보기 옵션 (펼친 책: 표지, 읽는 방향) -->
        <Geometry x:Key="BookIcon">M8,3.5 C6,2 3.5,2 1.5,2.5 V13.5 C3.5,13 6,13 8,14.5 C10,13 12.5,13 14.5,13.5 V2.5 C12.5,2 10,2 8,3.5 Z M8,3.5 V14.5</Geometry>

        <converters:InverseBooleanConverter x:Key="InverseBoolean" />

        <!-- 펜 색/굵기처럼 가로로 늘어놓고 하나를 고르는 목록 -->
        <Style x:Key="OptionListStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <!-- ListBoxItem은 클릭될 때 포커스를 받아야 선택되므로 Focusable을 끄면 안 된다. -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Padding="4" Margin="1" CornerRadius="4" BorderThickness="2"
                                            BorderBrush="Transparent" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource ButtonHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0067C0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 도구 옵션 팝업 -->
        <Style x:Key="FlyoutStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource ToolbarBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,4,8,8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A5A5A" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>

        <DataTemplate x:Key="ColorSwatchTemplate">
            <Ellipse Width="22" Height="22" Stroke="#30000000" StrokeThickness="1">
                <Ellipse.Fill>
                    <SolidColorBrush Color="{Binding}" />
                </Ellipse.Fill>
            </Ellipse>
        </DataTemplate>

        <Style x:Key="ToolSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{StaticResource ToolbarBorder}" />
        </Style>
    </Application.Resources>
</Application>
