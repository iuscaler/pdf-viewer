<Window x:Class="PDFViewer.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="암호 입력" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=PasswordBox}">
    <StackPanel Margin="20" Width="320">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <PasswordBox x:Name="PasswordBox" Height="28" VerticalContentAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="열기" Width="80" IsDefault="True" Click="OnOk" />
            <Button Content="취소" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
