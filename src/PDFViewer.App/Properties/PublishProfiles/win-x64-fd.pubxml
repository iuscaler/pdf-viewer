<?xml version="1.0" encoding="utf-8"?>
<!--
  배포용 릴리스 빌드 (런타임 별도 설치형): PC에 설치된 .NET 10 데스크톱 런타임을 쓰는 작은 폴더(약 8MB).
  실행 파일이 작아서 백신 검사가 짧고, 처음 실행이 win-x64(런타임 포함)보다 빠르다.
  dotnet publish src/PDFViewer.App -p:PublishProfile=win-x64-fd

  단일 파일로 묶으면(PublishSingleFile) 시작하자마자 런타임 오류로 종료되어서 폴더로 배포한다.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\..\publish\win-x64-fd\</PublishDir>
  </PropertyGroup>
</Project>
