<?xml version="1.0" encoding="utf-8"?>
<!--
  배포용 릴리스 빌드: .NET이 설치되지 않은 PC에서도 실행되는 실행 파일 하나.
  dotnet publish src/PDFViewer.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- .NET 런타임을 함께 넣는다 -->
    <SelfContained>true</SelfContained>
    <!-- 실행 파일 하나로 묶는다. PDFium·WPF 네이티브 DLL은 처음 실행할 때 임시 폴더에 풀린다. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 미리 컴파일해서 시작을 빠르게 한다 (파일은 커진다) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <!-- 참조한 프로젝트(Core)의 .pdb도 넣지 않는다 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
