<Window x:Class="PDFViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PDFViewer.App.Controls"
        xmlns:vm="clr-namespace:PDFViewer.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title}"
        Width="1100" Height="800" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        PreviewMouseMove="OnWindowPreviewMouseMove" PreviewKeyDown="OnWindowPreviewKeyDown"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding FitPageCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding FitPageCommand}" />
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad1" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding FitWidthCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad2" Command="{Binding FitWidthCommand}" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding ShowSinglePageCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad4" Command="{Binding ShowSinglePageCommand}" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding ShowTwoPagesCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad5" Command="{Binding ShowTwoPagesCommand}" />
        <KeyBinding Modifiers="Control" Key="Home" Command="{Binding FirstPageCommand}" />
        <KeyBinding Modifiers="Control" Key="End" Command="{Binding LastPageCommand}" />
        <KeyBinding Key="F11" Command="{Binding ToggleFullScreenCommand}" />
        <KeyBinding Key="F5" Command="{Binding TogglePresentationCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitFullScreenCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 툴바. 전체화면에서는 문서 위에 겹쳐서 필요할 때만 나타난다. -->
        <Border x:Name="Toolbar" Grid.Row="0" Panel.ZIndex="1"
                Background="{StaticResource ToolbarBackground}"
                BorderBrush="{StaticResource ToolbarBorder}" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ToolButtonStyle}" Command="{Binding OpenCommand}"
                        ToolTip="열기 (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8E5;" />
                        <TextBlock Text="열기" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- 페이지 이동 -->
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding PreviousPageCommand}"
                            ToolTip="이전 페이지">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE70E;" />
                    </Button>
                    <TextBox x:Name="PageNumberBox" Width="44" Height="26" VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center" Margin="2,0"
                             IsEnabled="{Binding IsDocumentOpen}"
                             Text="{Binding CurrentPageNumber}"
                             KeyDown="OnPageNumberKeyDown" GotKeyboardFocus="OnPageNumberGotFocus"
                             ToolTip="페이지 번호를 입력하고 Enter" />
                    <TextBlock VerticalAlignment="Center" Margin="4,0" Foreground="#5A5A5A"
                               Text="{Binding PageCount, StringFormat='/ {0}'}" />
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding NextPageCommand}"
                            ToolTip="다음 페이지">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE70D;" />
                    </Button>

                    <Border Style="{StaticResource ToolSeparatorStyle}" />

                    <!-- 확대/축소 -->
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ZoomOutCommand}"
                            ToolTip="축소 (Ctrl+-)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE71F;" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ActualSizeCommand}"
                            MinWidth="56" ToolTip="실제 크기 (Ctrl+1)">
                        <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ZoomInCommand}"
                            ToolTip="확대 (Ctrl++)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8A3;" />
                    </Button>

                    <Border Style="{StaticResource ToolSeparatorStyle}" />

                    <ToggleButton Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsDocumentOpen}"
                                  IsChecked="{Binding IsFitWidth}" Content="너비 맞춤"
                                  ToolTip="너비 맞춤 (Ctrl+2)" />
                    <ToggleButton Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsDocumentOpen}"
                                  IsChecked="{Binding IsFitPage}" Content="페이지 맞춤"
                                  ToolTip="페이지 맞춤 (Ctrl+0)" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- 보기 방식 메뉴 -->
                    <Button x:Name="ViewMenuButton" Style="{StaticResource ToolButtonStyle}"
                            IsEnabled="{Binding IsDocumentOpen}" Click="OnViewMenuButtonClick"
                            ToolTip="보기 방식: 1페이지 / 2페이지, 표지, 읽는 방향, 스크롤 방식">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE89A;" />
                            <TextBlock Text="보기" Margin="6,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE70D;" FontSize="10"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="1페이지 보기" InputGestureText="Ctrl+4" IsCheckable="True"
                                          IsChecked="{Binding IsSinglePage}" />
                                <MenuItem Header="2페이지 보기" InputGestureText="Ctrl+5" IsCheckable="True"
                                          IsChecked="{Binding IsTwoPage}" />
                                <MenuItem Header="표지 따로 보기" IsCheckable="True"
                                          IsEnabled="{Binding IsTwoPage}"
                                          IsChecked="{Binding ShowCoverSeparately}"
                                          ToolTip="2페이지 보기에서 첫 페이지(표지)를 혼자 보여줍니다." />
                                <MenuItem Header="오른쪽에서 왼쪽으로 읽기" IsCheckable="True"
                                          IsChecked="{Binding RightToLeft}"
                                          ToolTip="만화나 세로쓰기 책처럼 오른쪽 페이지부터 읽습니다. 페이지 단위에서는 ←가 다음 페이지입니다." />
                                <Separator />
                                <MenuItem Header="연속 스크롤" IsCheckable="True" IsChecked="{Binding IsContinuous}" />
                                <MenuItem Header="페이지 단위" IsCheckable="True" IsChecked="{Binding IsPageByPage}"
                                          ToolTip="한 화면씩 보여주고 페이지 끝에서 다음 페이지로 넘어갑니다." />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Border Style="{StaticResource ToolSeparatorStyle}" />

                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ToggleFullScreenCommand}"
                            ToolTip="전체화면 (F11)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE740;" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding TogglePresentationCommand}"
                            ToolTip="프레젠테이션 (F5)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE786;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="DocumentArea" Grid.Row="1" Background="{StaticResource DocumentBackground}">
            <ScrollViewer x:Name="DocumentScroller" CanContentScroll="True"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"
                          PreviewMouseLeftButtonDown="OnDocumentPreviewMouseLeftButtonDown"
                          PreviewMouseRightButtonDown="OnDocumentPreviewMouseRightButtonDown">
                <controls:PdfDocumentView x:Name="DocumentView"
                                          Document="{Binding Document}"
                                          Zoom="{Binding Zoom}"
                                          ZoomMode="{Binding ZoomMode}"
                                          ScrollMode="{Binding ScrollMode}"
                                          PageLayout="{Binding PageLayout}"
                                          ShowCoverSeparately="{Binding ShowCoverSeparately}"
                                          RightToLeft="{Binding RightToLeft}"
                                          CurrentPageIndex="{Binding CurrentPageIndex}" />
            </ScrollViewer>

            <!-- 문서가 없을 때 안내 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDocumentOpen}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8A5;" FontSize="48"
                           Foreground="#9A9A9A" HorizontalAlignment="Center" />
                <TextBlock Text="PDF 파일을 여기에 끌어다 놓거나 열기를 누르세요." Margin="0,16,0,12"
                           FontSize="14" Foreground="#5A5A5A" HorizontalAlignment="Center" />
                <Button Command="{Binding OpenCommand}" Content="PDF 열기" Padding="16,6"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
