<Window x:Class="PDFViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PDFViewer.App.Controls"
        xmlns:vm="clr-namespace:PDFViewer.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title}" Icon="Assets/app.ico"
        Width="1100" Height="800" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        PreviewMouseMove="OnWindowPreviewMouseMove" PreviewKeyDown="OnWindowPreviewKeyDown"
        Closing="OnWindowClosing"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Modifiers="Control" Key="P" Command="{Binding PrintCommand}" />
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding FitPageCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding FitPageCommand}" />
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad1" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding FitWidthCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad2" Command="{Binding FitWidthCommand}" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding ShowSinglePageCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad4" Command="{Binding ShowSinglePageCommand}" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding ShowTwoPagesCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad5" Command="{Binding ShowTwoPagesCommand}" />
        <KeyBinding Modifiers="Control" Key="Home" Command="{Binding FirstPageCommand}" />
        <KeyBinding Modifiers="Control" Key="End" Command="{Binding LastPageCommand}" />
        <KeyBinding Key="F11" Command="{Binding ToggleFullScreenCommand}" />
        <KeyBinding Key="F5" Command="{Binding TogglePresentationCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitFullScreenCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{Binding RedoCommand}" />
        <!-- 도구 단축키(V/P/H/E)는 글자 입력 칸에서 막아야 해서 MainWindow.xaml.cs의 PreviewKeyDown에서 처리한다. -->
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding OpenSearchCommand}" />
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding ToggleThumbnailsCommand}" />
        <KeyBinding Key="F3" Command="{Binding NextMatchCommand}" />
        <KeyBinding Modifiers="Shift" Key="F3" Command="{Binding PreviousMatchCommand}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <!-- 선택 도구로 고른 텍스트 복사 (Ctrl+C) -->
        <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyExecuted" CanExecute="OnCopyCanExecute" />
        <!-- 문서 전체 텍스트 선택 (Ctrl+A). 검색 창 등 글자 입력 칸에서는 그 칸이 먼저 처리한다. -->
        <CommandBinding Command="ApplicationCommands.SelectAll" Executed="OnSelectAllExecuted"
                        CanExecute="OnSelectAllCanExecute" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 툴바. 전체화면에서는 문서 위에 겹쳐서 필요할 때만 나타난다. -->
        <Border x:Name="Toolbar" Grid.Row="0" Panel.ZIndex="1"
                Background="{StaticResource ToolbarBackground}"
                BorderBrush="{StaticResource ToolbarBorder}" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsDocumentOpen}"
                                  IsChecked="{Binding IsThumbnailsOpen}" ToolTip="페이지 썸네일 (Ctrl+T)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE90C;" />
                    </ToggleButton>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding OpenCommand}"
                            ToolTip="열기 (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8E5;" />
                            <TextBlock Text="열기" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- 최근 파일 -->
                    <Button x:Name="RecentMenuButton" Style="{StaticResource ToolButtonStyle}" MinWidth="16"
                            Padding="2,0" IsEnabled="{Binding HasRecentFiles}" Click="OnRecentMenuButtonClick"
                            ToolTip="최근 파일">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE70D;" FontSize="10" />
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding RecentFiles}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding FileName}" />
                                        <Setter Property="ToolTip" Value="{Binding Path}" />
                                        <Setter Property="Command"
                                                Value="{Binding DataContext.OpenRecentCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding SaveCommand}"
                            ToolTip="저장 (Ctrl+S) / 다른 이름으로 저장 (Ctrl+Shift+S)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE74E;" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding PrintCommand}"
                            ToolTip="인쇄 (Ctrl+P)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE749;" />
                    </Button>

                    <Border Style="{StaticResource ToolSeparatorStyle}" />

                    <!-- 주석 도구 -->
                    <ToggleButton Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsDocumentOpen}"
                                  IsChecked="{Binding IsSelectTool}"
                                  ToolTip="선택 (V): 텍스트를 끌어서 선택하고 Ctrl+C로 복사합니다.">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8B0;" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsDocumentOpen}"
                                  IsChecked="{Binding IsPenTool}" ToolTip="펜 (P)">
                        <Grid>
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xEE56;" />
                            <!-- 현재 펜 색 -->
                            <Rectangle Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-5" RadiusX="1" RadiusY="1">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding PenColor}" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </ToggleButton>
                    <!-- 팝업이 열려 있는 동안 버튼이 클릭을 받지 않게 해서, 버튼을 눌러 닫을 때 다시 열리지 않게 한다 -->
                    <ToggleButton x:Name="PenOptionsButton" Style="{StaticResource ToolButtonStyle}"
                                  IsEnabled="{Binding IsDocumentOpen}" MinWidth="16" Padding="2,0"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=PenOptionsPopup,
                                                     Converter={StaticResource InverseBoolean}}"
                                  ToolTip="펜 색과 굵기">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE70D;" FontSize="10" />
                    </ToggleButton>
                    <Popup x:Name="PenOptionsPopup" IsOpen="{Binding IsChecked, ElementName=PenOptionsButton}"
                           StaysOpen="False" Closed="OnToolOptionsClosed"
                           PlacementTarget="{Binding ElementName=PenOptionsButton}" Placement="Bottom"
                           AllowsTransparency="True">
                        <Border Style="{StaticResource FlyoutStyle}">
                            <StackPanel Width="220">
                                <TextBlock Text="색" Style="{StaticResource FlyoutLabelStyle}" />
                                <ListBox ItemsSource="{x:Static vm:MainViewModel.PenColors}"
                                         SelectedItem="{Binding PenColor}"
                                         Style="{StaticResource OptionListStyle}"
                                         ItemTemplate="{StaticResource ColorSwatchTemplate}" />

                                <DockPanel Margin="0,12,0,2">
                                    <TextBlock Text="{Binding PenWidth, StringFormat={}{0:0.##} pt}"
                                               DockPanel.Dock="Right" Foreground="#5A5A5A" />
                                    <TextBlock Text="굵기" Style="{StaticResource FlyoutLabelStyle}" />
                                </DockPanel>
                                <Slider Minimum="{x:Static vm:MainViewModel.PenMinWidth}"
                                        Maximum="{x:Static vm:MainViewModel.PenMaxWidth}"
                                        Value="{Binding PenWidth}" TickFrequency="0.25" IsSnapToTickEnabled="True"
                                        SmallChange="0.25" LargeChange="1" />

                                <!-- 미리보기 -->
                                <Border Height="40" Margin="0,8,0,0" CornerRadius="4" Background="#F5F5F5">
                                    <Line X1="20" X2="200" Y1="20" Y2="20" StrokeThickness="{Binding PenWidth}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Line.Stroke>
                                            <SolidColorBrush Color="{Binding PenColor}" />
                                        </Line.Stroke>
                                    </Line>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <ToggleButton Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsDocumentOpen}"
                                  IsChecked="{Binding IsHighlighterTool}"
                                  ToolTip="형광펜 (H): 텍스트 위에서 끌면 글자를 칠하고, 그 밖에서는 자유롭게 칠합니다.">
                        <Grid>
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE7E6;" />
                            <!-- 현재 형광펜 색 -->
                            <Rectangle Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-5" RadiusX="1" RadiusY="1">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding HighlighterColor}" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="HighlighterOptionsButton" Style="{StaticResource ToolButtonStyle}"
                                  IsEnabled="{Binding IsDocumentOpen}" MinWidth="16" Padding="2,0"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=HighlighterOptionsPopup,
                                                     Converter={StaticResource InverseBoolean}}"
                                  ToolTip="형광펜 색과 굵기">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE70D;" FontSize="10" />
                    </ToggleButton>
                    <Popup x:Name="HighlighterOptionsPopup"
                           IsOpen="{Binding IsChecked, ElementName=HighlighterOptionsButton}" StaysOpen="False"
                           Closed="OnToolOptionsClosed"
                           PlacementTarget="{Binding ElementName=HighlighterOptionsButton}" Placement="Bottom"
                           AllowsTransparency="True">
                        <Border Style="{StaticResource FlyoutStyle}">
                            <StackPanel Width="220">
                                <TextBlock Text="색" Style="{StaticResource FlyoutLabelStyle}" />
                                <ListBox ItemsSource="{x:Static vm:MainViewModel.HighlighterColors}"
                                         SelectedItem="{Binding HighlighterColor}"
                                         Style="{StaticResource OptionListStyle}"
                                         ItemTemplate="{StaticResource ColorSwatchTemplate}" />

                                <DockPanel Margin="0,12,0,2">
                                    <TextBlock Text="{Binding HighlighterWidth, StringFormat={}{0:0} pt}"
                                               DockPanel.Dock="Right" Foreground="#5A5A5A" />
                                    <TextBlock Text="굵기 (자유 형광펜)" Style="{StaticResource FlyoutLabelStyle}" />
                                </DockPanel>
                                <Slider Minimum="{x:Static vm:MainViewModel.HighlighterMinWidth}"
                                        Maximum="{x:Static vm:MainViewModel.HighlighterMaxWidth}"
                                        Value="{Binding HighlighterWidth}" TickFrequency="1"
                                        IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4" />

                                <!-- 미리보기: 얇은 사각형 펜촉이 진행 방향에 수직으로 지나간 모양 (끝이 평평함) -->
                                <Border Height="40" Margin="0,8,0,0" CornerRadius="4" Background="#F5F5F5"
                                        ClipToBounds="True">
                                    <Line X1="20" X2="200" Y1="20" Y2="20" StrokeThickness="{Binding HighlighterWidth}"
                                          StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" Opacity="0.7">
                                        <Line.Stroke>
                                            <SolidColorBrush Color="{Binding HighlighterColor}" />
                                        </Line.Stroke>
                                    </Line>
                                </Border>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#5A5A5A" FontSize="12"
                                           Text="텍스트 위에서 끌면 글자 높이에 맞춰 칠합니다." />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <ToggleButton Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsDocumentOpen}"
                                  IsChecked="{Binding IsEraserTool}"
                                  ToolTip="지우개 (E): 획을 눌러서 지웁니다. 펜 뒤쪽으로도 지울 수 있습니다.">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE75C;" />
                    </ToggleButton>

                    <Border Style="{StaticResource ToolSeparatorStyle}" />

                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding UndoCommand}"
                            ToolTip="실행 취소 (Ctrl+Z)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE7A7;" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding RedoCommand}"
                            ToolTip="다시 실행 (Ctrl+Y)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE7A6;" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- 페이지 이동 -->
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding PreviousPageCommand}"
                            ToolTip="이전 페이지">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE70E;" />
                    </Button>
                    <TextBox x:Name="PageNumberBox" Width="44" Height="26" VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center" Margin="2,0"
                             IsEnabled="{Binding IsDocumentOpen}"
                             Text="{Binding CurrentPageNumber}"
                             KeyDown="OnPageNumberKeyDown" GotKeyboardFocus="OnPageNumberGotFocus"
                             ToolTip="페이지 번호를 입력하고 Enter" />
                    <TextBlock VerticalAlignment="Center" Margin="4,0" Foreground="#5A5A5A"
                               Text="{Binding PageCount, StringFormat='/ {0}'}" />
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding NextPageCommand}"
                            ToolTip="다음 페이지">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE70D;" />
                    </Button>

                    <Border Style="{StaticResource ToolSeparatorStyle}" />

                    <!-- 확대/축소 -->
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ZoomOutCommand}"
                            ToolTip="축소 (Ctrl+-)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE71F;" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ActualSizeCommand}"
                            MinWidth="56" ToolTip="실제 크기 (Ctrl+1)">
                        <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ZoomInCommand}"
                            ToolTip="확대 (Ctrl++)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8A3;" />
                    </Button>

                    <Border Style="{StaticResource ToolSeparatorStyle}" />

                    <ToggleButton Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsDocumentOpen}"
                                  IsChecked="{Binding IsFitWidth}" ToolTip="너비 맞춤 (Ctrl+2)">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource FitWidthIcon}" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsDocumentOpen}"
                                  IsChecked="{Binding IsFitPage}" ToolTip="페이지 맞춤 (Ctrl+0)">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource FitPageIcon}" />
                    </ToggleButton>

                    <Border Style="{StaticResource ToolSeparatorStyle}" />

                    <!-- 보기 방식 -->
                    <ToggleButton Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsDocumentOpen}"
                                  IsChecked="{Binding IsSinglePage}" ToolTip="1페이지 보기 (Ctrl+4)">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource SinglePageIcon}" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsDocumentOpen}"
                                  IsChecked="{Binding IsTwoPage}" ToolTip="2페이지 보기 (Ctrl+5)">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource TwoPageIcon}" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsDocumentOpen}"
                                  IsChecked="{Binding IsContinuous}"
                                  ToolTip="연속 스크롤: 끄면 한 화면씩 보여주고 페이지 끝에서 다음 페이지로 넘어갑니다.">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource ContinuousIcon}" />
                    </ToggleButton>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- 보기 옵션 메뉴 -->
                    <Button x:Name="ViewMenuButton" Style="{StaticResource ToolButtonStyle}"
                            IsEnabled="{Binding IsDocumentOpen}" Click="OnViewMenuButtonClick"
                            ToolTip="보기: 맞춤, 1페이지 / 2페이지, 표지, 스크롤 방식, 읽는 방향">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource BookIcon}" />
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE70D;" FontSize="10"
                                       Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <!-- 도구 모음의 보기 버튼과 같은 속성에 묶여 있어서 어느 쪽에서 바꿔도 함께 바뀐다. -->
                            <ContextMenu>
                                <MenuItem Header="너비 맞춤" InputGestureText="Ctrl+2" IsCheckable="True"
                                          IsChecked="{Binding IsFitWidth}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IconPathStyle}"
                                              Data="{StaticResource FitWidthIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="페이지 맞춤" InputGestureText="Ctrl+0" IsCheckable="True"
                                          IsChecked="{Binding IsFitPage}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IconPathStyle}"
                                              Data="{StaticResource FitPageIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="1페이지 보기" InputGestureText="Ctrl+4" IsCheckable="True"
                                          IsChecked="{Binding IsSinglePage}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IconPathStyle}"
                                              Data="{StaticResource SinglePageIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="2페이지 보기" InputGestureText="Ctrl+5" IsCheckable="True"
                                          IsChecked="{Binding IsTwoPage}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IconPathStyle}"
                                              Data="{StaticResource TwoPageIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="연속 스크롤" IsCheckable="True" IsChecked="{Binding IsContinuous}"
                                          ToolTip="끄면 한 화면씩 보여주고 페이지 끝에서 다음 페이지로 넘어갑니다.">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IconPathStyle}"
                                              Data="{StaticResource ContinuousIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="표지 따로 보기" IsCheckable="True"
                                          IsEnabled="{Binding IsTwoPage}"
                                          IsChecked="{Binding ShowCoverSeparately}"
                                          ToolTip="2페이지 보기에서 첫 페이지(표지)를 혼자 보여줍니다." />
                                <MenuItem Header="오른쪽에서 왼쪽으로 읽기" IsCheckable="True"
                                          IsChecked="{Binding RightToLeft}"
                                          ToolTip="만화나 세로쓰기 책처럼 오른쪽 페이지부터 읽습니다. 연속 스크롤을 끄면 ←가 다음 페이지입니다." />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Border Style="{StaticResource ToolSeparatorStyle}" />

                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding OpenSearchCommand}"
                            ToolTip="검색 (Ctrl+F)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE721;" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ToggleFullScreenCommand}"
                            ToolTip="전체화면 (F11)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE740;" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding TogglePresentationCommand}"
                            ToolTip="프레젠테이션 (F5)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE786;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="DocumentArea" Grid.Row="1" Background="{StaticResource DocumentBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 썸네일 사이드바 -->
            <Border Grid.Column="0" Background="{StaticResource ToolbarBackground}"
                    BorderBrush="{StaticResource ToolbarBorder}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsThumbnailsOpen}" Value="True" />
                                    <Condition Binding="{Binding IsDocumentOpen}" Value="True" />
                                    <Condition Binding="{Binding IsPresentation}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ListBox x:Name="ThumbnailList" Width="168" BorderThickness="0" Background="Transparent"
                         ItemsSource="{Binding Thumbnails}"
                         SelectedIndex="{Binding CurrentPageIndex}"
                         SelectionChanged="OnThumbnailSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Margin="6,4" Padding="6" CornerRadius="6"
                                                Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource ButtonHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource ButtonChecked}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border Background="White" BorderBrush="#40000000" BorderThickness="1">
                                    <controls:PageThumbnail
                                        Width="{x:Static vm:MainViewModel.ThumbnailWidth}" Height="{Binding Height}"
                                        Document="{Binding DataContext.Document,
                                                   RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        PageIndex="{Binding PageIndex}" Revision="{Binding Revision}" />
                                </Border>
                                <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                           Foreground="#5A5A5A" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 키보드 스크롤을 위해 포커스는 받지만, 키보드를 쓴 뒤 문서 테두리에 점선(포커스 표시)은 그리지 않는다. -->
            <ScrollViewer x:Name="DocumentScroller" Grid.Column="1" CanContentScroll="True"
                          FocusVisualStyle="{x:Null}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"
                          PreviewMouseLeftButtonDown="OnDocumentPreviewMouseLeftButtonDown"
                          PreviewMouseRightButtonDown="OnDocumentPreviewMouseRightButtonDown">
                <controls:PdfDocumentView x:Name="DocumentView"
                                          Document="{Binding Document}"
                                          Zoom="{Binding Zoom}"
                                          ZoomMode="{Binding ZoomMode}"
                                          ScrollMode="{Binding ScrollMode}"
                                          PageLayout="{Binding PageLayout}"
                                          ShowCoverSeparately="{Binding ShowCoverSeparately}"
                                          RightToLeft="{Binding RightToLeft}"
                                          Annotations="{Binding Annotations}"
                                          ActiveTool="{Binding ActiveTool}"
                                          PenColor="{Binding PenColor}"
                                          PenWidth="{Binding PenWidth}"
                                          HighlighterColor="{Binding HighlighterColor}"
                                          HighlighterWidth="{Binding HighlighterWidth}"
                                          SearchResults="{Binding SearchResults}"
                                          CurrentSearchMatch="{Binding CurrentSearchMatch, Mode=OneWay}"
                                          CurrentPageIndex="{Binding CurrentPageIndex}" />
            </ScrollViewer>

            <!-- 문서가 없을 때 안내 -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDocumentOpen}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8A5;" FontSize="48"
                           Foreground="#9A9A9A" HorizontalAlignment="Center" />
                <TextBlock Text="PDF 파일을 여기에 끌어다 놓거나 열기를 누르세요." Margin="0,16,0,12"
                           FontSize="14" Foreground="#5A5A5A" HorizontalAlignment="Center" />
                <Button Command="{Binding OpenCommand}" Content="PDF 열기" Padding="16,6"
                        HorizontalAlignment="Center" />

                <!-- 최근 파일 -->
                <StackPanel Margin="0,28,0,0" Width="420"
                            Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="4,0,4,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButtonStyle}" Height="24"
                                FontSize="12" Foreground="#5A5A5A" Content="목록 지우기"
                                Command="{Binding ClearRecentFilesCommand}" />
                        <TextBlock Text="최근 파일" Foreground="#5A5A5A" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ToolButtonStyle}" Height="Auto" Padding="10,6"
                                        HorizontalContentAlignment="Stretch" ToolTip="{Binding Path}"
                                        Command="{Binding DataContext.OpenRecentCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Width="390">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="#7A7A7A"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- 검색 창 (Ctrl+F) -->
            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,24,0"
                    Style="{StaticResource FlyoutStyle}" Padding="6"
                    Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchBox" Width="220" Height="28" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnSearchBoxPreviewKeyDown" />
                    <TextBlock Text="{Binding SearchStatus}" MinWidth="64" Margin="8,0" Foreground="#5A5A5A"
                               VerticalAlignment="Center" TextAlignment="Center" />
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding PreviousMatchCommand}"
                            ToolTip="이전 결과 (Shift+Enter, Shift+F3)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE70E;" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding NextMatchCommand}"
                            ToolTip="다음 결과 (Enter, F3)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE70D;" />
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding CloseSearchCommand}"
                            ToolTip="닫기 (Esc)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- 인쇄 진행 ("인쇄 중 3/10") -->
            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                    Style="{StaticResource FlyoutStyle}" Padding="16,8"
                    Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE749;" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PrintStatus}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <ProgressBar Grid.ColumnSpan="2" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
